# GhostLine configuration template.
# Do NOT fill this file by hand: run `bash scripts/gen_secrets.sh` to create .env
# with fresh random values. Never commit .env.

# One of: development | production | testing
GHOSTLINE_CONFIG=development

# 32-byte secrets as 64 hex chars (openssl rand -hex 32)
SECRET_KEY=<generate-with-openssl-rand-hex-32>
AUDIT_HMAC_KEY=<generate-with-openssl-rand-hex-32>
DATA_ENC_KEY=<generate-with-openssl-rand-hex-32>
PRELOGIN_SALT_KEY=<generate-with-openssl-rand-hex-32>

HOST=127.0.0.1
PORT=5443

# Optional overrides
# DATABASE_URL=sqlite:///absolute/path/ghostline.db
# TLS_CERT=certs/server.crt
# TLS_KEY=certs/server.key
# SIGNING_KEY=certs/signing_ed25519.key
# GHOSTLINE_DEBUG=1          # enables the Werkzeug debugger (local use only)
# GHOSTLINE_FORCE_HTTPS=1
